{
  "name": "parabank-playwright-automation",
  "version": "1.0.0",
  "description": "Playwright TypeScript E2E Test Automation Framework for ParaBank Online Banking",
  "main": "index.js",
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui",
    "test:debug": "playwright test --debug",
    "test:chromium": "playwright test --project=Chromium --headed",
    "report": "playwright show-report"
  },
  "keywords": [
    "playwright",
    "typescript",
    "parabank",
    "banking",
    "automation",
    "e2e"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@playwright/test": "^1.40.0",
    "@types/node": "^20.10.0",
    "typescript": "^5.3.0"
  }
}