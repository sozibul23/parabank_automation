{
  "compilerOptions": {
    "target": "ESNext",
    "module": "commonjs",
    "moduleResolution": "node",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "baseUrl": ".",
    "paths": {
      "@pages/*": [
        "pages/*"
      ],
      "@tests/*": [
        "tests/*"
      ]
    }
  },
  "include": [
    "pages/**/*.ts",
    "tests/**/*.ts",
    "playwright.config.ts"
  ]
}